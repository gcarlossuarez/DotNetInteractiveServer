	texto = @"19
	Malmedy 10 20
	Stavelot 9 30
	19
	MMalmedy 10 20
	
	19
	Malmedy 10 20
	Stavelot 9 30
	
	A 12 13
	
	BB 13 15
	";
	string[] actual = texto.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
	actual.Dump();
	int cursor=0;
	while(cursor < actual.Length)
	{
		var block = GetBlock(actual, ref cursor);
		"AAA".Dump();
		block.Dump("BLOQUE ACTUAL");
	}
	
}

static string[] GetBlock(string[] actual, ref int cursor)
{
	List<string> block = new List<string>();
	int initialCursor=cursor;
	block.Add(actual[cursor++]);
	while(cursor < actual.Length)
	{	if(actual[cursor].Split(' ', StringSplitOptions.RemoveEmptyEntries).Length == 1)
		{
			return block.ToArray();
		}
		block.Add(actual[cursor++]);
	}
	return block.ToArray();
}

